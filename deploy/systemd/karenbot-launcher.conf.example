# 样例：复制到 ~/.config/systemd/user/karenbot.service.d/launcher.conf
# 本轮未安装、未 daemon-reload、未重启。请先把路径改成实际数据目录。
[Service]
ExecStart=
ExecStart=/usr/local/lib/karen/trusted_launcher.py --project-root /opt/karenbot --data-dir /var/lib/karenbot/instances/default -- /opt/karenbot/.venv/bin/python /opt/karenbot/main.py --host 0.0.0.0 --port 8000
